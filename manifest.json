{
  "manifest_version": 3,
  "name": "Admin Toolkit for Salesforce",
  "version": "0.11.1",
  "description": "Salesforce admin toolkit for metadata, org differences, SOQL, permissions, APIs, Apex, exports, and monitoring.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*",
    "https://*.vf.force.com/*",
    "https://*.lightning.force.com/*",
    "https://*.visualforce.com/*",
    "https://*.cloudforce.com/*",
    "https://*.my.site.com/*",
    "https://*.salesforce-sites.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Admin Toolkit for Salesforce",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
